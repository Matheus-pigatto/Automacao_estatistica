# Copie este arquivo para ".env" na raiz do projeto e preencha com suas credenciais reais.
# Nunca versione o arquivo .env (ele já está no .gitignore).

VALECAP_CPF=00000000000
VALECAP_SENHA=sua_senha_aqui

# --- Configurações ADB (BlueStacks 100% em segundo plano) ---
# Deixe vazio para autodetectar HD-Adb.exe do BlueStacks ou adb no PATH
ADB_BIN=
# No BlueStacks, ative "Android Debug Bridge (ADB)" nas configurações e use o endereço exibido
ADB_DEVICE=127.0.0.1:6610
# Pacote do app Vale Cap no Android (para abrir automaticamente via ADB)
ANDROID_APP_PACKAGE=com.ideamaker.valecap

# (Opcional) Caminho do executável tesseract.exe caso não esteja no PATH
TESSERACT_CMD=

# --- Bot Telegram (para receber cartelas e aprovar/descartar pelo celular) ---
# Crie um bot com @BotFather e pegue seu Chat ID com @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
